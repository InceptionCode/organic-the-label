# Copy this file to `.env.local` and replace placeholders with your own keys.
# Never commit real secrets.
#
# Local / preview work typically uses SHOPIFY_DEV_STORE_DOMAIN;
# production uses SHOPIFY_PROD_STORE_DOMAIN.
# Next.js also loads `.env.development` / `.env.production` / `.env.test`
# depending on the command.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
INTERNAL_SUPABASE_WEBHOOK_SECRET=your_internal_supabase_webhook_secret
SUPABASE_SUPPORT_WEBHOOK_SECRET=your_supabase_support_webhook_secret

# --- Auth / site ---
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# --- Shopify ---
SHOPIFY_PUBLIC_ACCESS_TOKEN=your_shopify_public_access_token
SHOPIFY_SECRET_KEY=your_shopify_secret_key
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret
SHOPIFY_REVALIDATE_SECRET=your_shopify_revalidate_secret
SHOPIFY_ORDER_PAID_SECRET=your_shopify_order_paid_secret
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_shopify_storefront_access_token
SHOPIFY_STOREFRONT_API_VERSION=2026-01
SHOPIFY_DEV_STORE_DOMAIN=https://your-dev-store.myshopify.com
SHOPIFY_PROD_STORE_DOMAIN=https://your-prod-store.myshopify.com

# --- Email (Resend + MailerLite) ---
RESEND_API_KEY=re_your_resend_api_key
MAILERLITE_API_KEY=your_mailerlite_api_key
EMAIL_FROM_DOWNLOADS="Organic Sonics Downloads <downloads@example.com>"
EMAIL_FROM_SUPPORT="Organic Sonics Support <support@example.com>"
EMAIL_FROM_NEWSLETTER="Organic Sonics <newsletter@example.com>"
SUPPORT_FORWARD_EMAIL=you@example.com
MAILERLITE_GROUP_NEWSLETTER_ID=your_group_id
MAILERLITE_GROUP_FREE_RESOURCE_LEADS_ID=your_group_id
MAILERLITE_GROUP_DOWNLOADED_STARTER_KIT_ID=your_group_id
MAILERLITE_GROUP_CUSTOMERS_ID=your_group_id
MAILERLITE_WEBHOOK_SECRET=your_mailerlite_webhook_secret

# --- Integrations (Work With Me / cron) ---
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
YOUTUBE_API_KEY=your_youtube_api_key
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_WEBHOOK_TOKEN=your_instagram_webhook_token
INSTAGRAM_USER_ID=your_instagram_user_id
CRON_SECRET=your_cron_secret

# --- Optional: explore feature flags ---
# NEXT_PUBLIC_EXPLORE_PAGE_ENABLED=true
# NEXT_PUBLIC_EXPLORE_HERO_ENABLED=true
# NEXT_PUBLIC_EXPLORE_EMAIL_SIGNUP_ENABLED=true
# NEXT_PUBLIC_EXPLORE_MEMBERSHIP_ENABLED=true
# NEXT_PUBLIC_EXPLORE_NEWS_ENABLED=true
# NEXT_PUBLIC_EXPLORE_COMMUNITY_ENABLED=true
# NEXT_PUBLIC_EXPLORE_DISCOVERY_ENABLED=true
# NEXT_PUBLIC_EXPLORE_RESOURCES_ENABLED=true

# --- Optional: Playwright ---
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# PLAYWRIGHT_TEST_EMAIL=test@example.com
# PLAYWRIGHT_TEST_PASSWORD=your_test_password
