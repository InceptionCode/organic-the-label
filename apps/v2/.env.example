# Organic Sonics v2 environment variables. Copy to .env.development and fill in.
# Only VITE_* variables reach the browser. Everything else is server-only.

# --- Public (client) ---
# Supabase project URL
VITE_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...). Replaces the legacy anon key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# hCaptcha site key (public)
VITE_HCAPTCHA_SITE_KEY=
# Membership feature flag. Off unless exactly "true": membership sections render as "coming soon"
# promos (CTA to the newsletter) and other membership mentions are reworded. "true" restores the
# full membership pitch and join CTAs.
VITE_MEMBERSHIP_ENABLED=

# --- Supabase (server) ---
# Supabase secret key (sb_secret_...). Replaces the legacy service role key.
# Used only by named server services (visitor, merge, entitlements). No JWT secret is needed:
# tokens are verified against the project's public JWKS (asymmetric signing keys).
SUPABASE_SECRET_KEY=

# --- Site ---
# Bare origin, no trailing slash (e.g. https://organicsonics.com). Used for auth email redirects.
SITE_URL=

# --- Shopify Storefront (server) ---
# Store domain (dev store in development/preview, live store in production)
SHOPIFY_DEV_STORE_DOMAIN=
# Private Storefront API access token
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Storefront API version (e.g. 2025-07)
SHOPIFY_STOREFRONT_API_VERSION=

# --- Cache (optional; falls back to direct fetches) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- hCaptcha (server) ---
# Verifies captcha tokens on non-auth forms (contact, free resources). Auth forms use Supabase's CAPTCHA protection.
HCAPTCHA_SECRET_KEY=

# --- Email (optional at boot; checked when first used) ---
RESEND_API_KEY=
EMAIL_FROM_SUPPORT=
EMAIL_FROM_DOWNLOADS=
SUPPORT_FORWARD_EMAIL=
MAILERLITE_API_KEY=
MAILERLITE_GROUP_NEWSLETTER_ID=
MAILERLITE_GROUP_FREE_RESOURCE_LEADS_ID=
MAILERLITE_GROUP_DOWNLOADED_STARTER_KIT_ID=

# --- Media for /work-with-me (optional; page falls back like v1 without them) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
