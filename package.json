{
  "name": "organic-the-label",
  "version": "1.8.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/@organic/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:v2": "bun run --cwd apps/v2 dev",
    "dev:api": "bun run --cwd apps/api dev",
    "build": "next build",
    "generate-dev": "NODE_ENV=development bun generate-seed && NODE_OPTIONS='--inspect' next dev --turbopack",
    "generate-seed": "bun seed.ts",
    "seed:free-resources:dev": "NODE_ENV=development bun seed-free-resources.ts",
    "seed:free-resources:prod": "NODE_ENV=production bun seed-free-resources.ts",
    "seed:compositions:dev": "NODE_ENV=development bun seed-compositions.ts",
    "seed:compositions:prod": "NODE_ENV=production bun seed-compositions.ts",
    "start": "next start",
    "serve": "bun run build && bun run start",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --max-warnings 0",
    "lint:fix": "eslint . --cache --cache-location node_modules/.cache/eslint/ --fix",
    "type-check": "tsc --noEmit",
    "type-check:v2": "bun run --cwd apps/v2 type-check",
    "type-check:api": "bun run --cwd apps/api type-check",
    "type-check:all": "bun run type-check && bun run type-check:v2 && bun run type-check:api",
    "type-check:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "test": "bun test",
    "test:unit": "bun test tests/unit packages",
    "test:integration": "bun test tests/integration",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:cold": "lsof -ti tcp:3000 | xargs kill -9 2>/dev/null || true; rm -rf .next && CI=1 playwright test",
    "test:ci": "bun test tests/unit packages && bun test tests/integration",
    "test:all": "bun run test:ci && bun run test:e2e:cold",
    "db:setup": "psql $SUPABASE_DB_URL -f supabase/schema.sql",
    "changelog": "git-cliff --unreleased",
    "release": "bash scripts/release.sh",
    "prepare": "husky && bash scripts/fix-vite-dedup.sh"
  },
  "dependencies": {
    "@conform-to/react": "^1.13.3",
    "@conform-to/zod": "^1.13.3",
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@organic/content-schema": "workspace:*",
    "@paper-design/shaders-react": "^0.0.72",
    "@radix-ui/react-alert-dialog": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-select": "^2.1.5",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@radix-ui/react-visually-hidden": "^1.2.0",
    "@shopify/storefront-api-client": "^1.0.9",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "babel-plugin-react-compiler": "19.0.0-beta-ebf51a3-20250411",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.488.0",
    "next": "16.0.10",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.55.0",
    "react-social-icons": "^6.24.0",
    "resend": "^6.25.0",
    "tailwind-merge": "^3.2.0",
    "tailwind-variants": "^1.0.0",
    "three": "^0.185.1",
    "zod": "^4.1.13",
    "zustand": "^5.0.3"
  },
  "overrides": {
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3.3.1",
    "@headlessui/react": "^2.2.1",
    "@heroicons/react": "^2.2.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/lodash": "^4.17.16",
    "@types/node": "^20.17.30",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.8.32",
    "bun-types": "^1.4.2",
    "dotenv": "^16.5.0",
    "eslint": "^9.24.0",
    "eslint-config-next": "^16.0.1",
    "flowbite": "^4.0.1",
    "git-cliff": "^2.13.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lodash": "^4.17.21",
    "msw": "^2.12.14",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "puppeteer": "^24.40.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.2.8",
    "typescript": "^5.8.3"
  }
}
